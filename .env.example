# Anthropic API key — get one at console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Optional: directory where the ChromaDB vector store is persisted
CHROMA_DB_PATH=./data/chroma_db

# Optional: directory where scraped transcripts are cached as JSON
TRANSCRIPTS_PATH=./data/transcripts

# ── GP Sourcing Agent ──────────────────────────────────────────────────

# Optional: Tavily API key for higher-quality web search (https://tavily.com)
# If not set, DuckDuckGo search is used automatically (no key required)
TAVILY_API_KEY=
